# === LLM ===
LLM_API_KEY=
# openai | openrouter | local-vllm | mock (default mock = работает без ключа)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Порог релевантности retrieval: 0.12 для TF-IDF fallback; 0.75 после перехода на embeddings (см. docs/ADMIN_GUIDE.md)
LLM_THRESHOLD=0.12
# === DB ===
# postgres (docker) или sqlite (local). Формат: postgresql://user:pass@host/db или sqlite:///./lorai.db
DATABASE_URL=sqlite:///./lorai.db
POSTGRES_USER=lorai
POSTGRES_PASSWORD=lorai
POSTGRES_DB=lorai
# === Vector ===
VECTOR_BACKEND=embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Проиндексировать: python scripts/reindex_embeddings.py (модель скачается в data/hf_cache)
# Порог скора: у TF-IDF 0.12, у эмбеддингов своя шкала — домены разделяет домен-гейт
EMBEDDING_THRESHOLD=0.75
# Маршрутизация вопроса по разделам протокола и предел обзорных чанков
SECTION_BOOST=1.15
GENERAL_CHUNK_CAP=2
HYBRID_WEIGHT=0.15
CHROMA_DIR=./data/vector_store
# === Auth ===
# ОБЯЗАТЕЛЬНО сменить перед production: с дефолтом запуск в prod-режиме (LORAI_ENV=production) завершится ошибкой
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# === App ===
ADMIN_EMAIL=admin@lorai.local
ADMIN_PASSWORD=admin123
# Врачебный аккаунт опционален: задаётся ТОЛЬКО этими переменными (дефолтного doctor@lorai.local больше нет)
LORAI_DOCTOR_EMAIL=
LORAI_DOCTOR_PASSWORD=
# production|development — в production дефолтный JWT_SECRET запрещён (fail-fast)
LORAI_ENV=development
# CORS allowlist для web-клиентов (native-клиенты без Origin не затрагиваются)
# CORS-allowlist web-клиентов разработки: перечислите порты, на которых
# реально запущен frontend (vite может занять 5200/5174 и т.п.), иначе
# браузер заблокирует запросы к API.
LORAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5200,http://127.0.0.1:5200
BACKEND_PORT=8000
FRONTEND_PORT=5173
