# === LLM ===
LLM_API_KEY=
# openai | openrouter | local-vllm | mock (default mock = работает без ключа)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Порог релевантности retrieval: 0.12 для TF-IDF fallback; 0.75 после перехода на embeddings (см. docs/ADMIN_GUIDE.md)
LLM_THRESHOLD=0.12
# === DB ===
# postgres (docker) или sqlite (local). Формат: postgresql://user:pass@host/db или sqlite:///./lorai.db
DATABASE_URL=sqlite:///./lorai.db
POSTGRES_USER=lorai
POSTGRES_PASSWORD=lorai
POSTGRES_DB=lorai
# === Vector ===
VECTOR_BACKEND=embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Проиндексировать: python scripts/reindex_embeddings.py (модель скачается в data/hf_cache)
# Порог скора: у TF-IDF 0.12, у эмбеддингов своя шкала — домены разделяет домен-гейт
EMBEDDING_THRESHOLD=0.75
# Маршрутизация вопроса по разделам протокола и предел обзорных чанков
SECTION_BOOST=1.15
GENERAL_CHUNK_CAP=2
HYBRID_WEIGHT=0.15
CHROMA_DIR=./data/vector_store
# === Реранкер ===
# off | cross. Включать только после замера на hold-out: python scripts/eval_retrieval.py --holdout --rerank
# Замер 2026-10-21 (DiTy/cross-encoder-russian-msmarco, blend 0.3, top-20):
#   hold-out  recall@6 0.864 → 0.909, protocol+section 0.864 → 0.909, MRR 0.908 → 0.871, recall@1 без изменений
#   golden    recall@6 0.933 → 0.967, protocol+section 0.933 → 0.967, MRR 0.829 → 0.813
# Цена: ~1 с на запрос (top-20) или ~0.5 с (top-10, но и выигрыша нет — он весь в кандидатах 11–20).
# Модель (~700 МБ) скачается в data/hf_cache при первом запросе; для офлайн-контура
# предварительно: python -c "from huggingface_hub import snapshot_download as d; d('DiTy/cross-encoder-russian-msmarco', cache_dir='data/hf_cache')"
RERANK_BACKEND=off
RERANK_MODEL=DiTy/cross-encoder-russian-msmarco
RERANK_TOP_N=20
RERANK_BLEND=0.3
# === Логи ===
# text — человеку в терминале; json — одна строка на запись (Loki/ELK/CloudWatch)
LOG_FORMAT=text
# === Auth ===
# ОБЯЗАТЕЛЬНО сменить перед production: с дефолтом запуск в prod-режиме (LORAI_ENV=production) завершится ошибкой
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# === App ===
# Первый администратор создаётся из этих переменных ТОЛЬКО при первом запуске
# (пустая таблица users). Дальше учётки живут в БД и управляются в админ-панели —
# смена пароля здесь больше не действует.
ADMIN_EMAIL=admin@lorai.local
ADMIN_PASSWORD=admin123
# Врачебный аккаунт опционален: задаётся ТОЛЬКО этими переменными (дефолтного doctor@lorai.local больше нет)
LORAI_DOCTOR_EMAIL=
LORAI_DOCTOR_PASSWORD=
# Политика хранения: тексты клинических запросов и журнал действий не хранятся вечно.
# 0 — отключить очистку (не рекомендуется: ПДн-фильтр не абсолютен).
QUERY_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# production|development — в production дефолтный JWT_SECRET запрещён (fail-fast)
LORAI_ENV=development
# CORS allowlist для web-клиентов (native-клиенты без Origin не затрагиваются)
# CORS-allowlist web-клиентов разработки: перечислите порты, на которых
# реально запущен frontend (vite может занять 5200/5174 и т.п.), иначе
# браузер заблокирует запросы к API.
LORAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5200,http://127.0.0.1:5200
BACKEND_PORT=8000
FRONTEND_PORT=5173
